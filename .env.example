# ── Required by the web app (safe for the browser; protected by Row Level Security) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase Dashboard → Project Settings → API → "anon" (legacy) or "publishable" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ── Server-only: used ONLY by `npm run seed` and the integration/E2E test helpers ──
# NEVER prefix with NEXT_PUBLIC_, never commit, and do NOT set this in Vercel for the web app.
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── Shared password used for the seeded demo/test users (change if you like) ──
SEED_PASSWORD=Demo-Pass-123!

# ── Playwright (defaults shown) ──
# E2E_BASE_URL=http://localhost:3000
